{
  "$schema": "https://devhive.local/policies.schema.json",
  "version": "2.2.0-devhive-runtime",
  "system": "DevHive",
  "updated": "2026-08-12T15:30:00Z",
  "agents": {
    "architect": {
      "directories": [
        ".devhive/",
        ".agents/*/SKILL.md"
      ],
      "allowed_actions": [
        "read",
        "write",
        "create",
        "review"
      ],
      "allowed_file_patterns": [
        ".devhive/*.md",
        ".devhive/decisions/*.md",
        ".devhive/sessions/*.md",
        ".agents/*/SKILL.md"
      ],
      "denied_file_patterns": [
        "backend/app/**",
        "frontend/src/**",
        "scripts/**",
        "docker-compose.yml",
        "Dockerfile.*",
        ".env*",
        "certs/**"
      ],
      "require_approval_for": [
        "Change technology stack",
        "Modify base conventions",
        "Modify project-brief.md stack section",
        "Remove agents from the team",
        "Approve integration with external identity providers"
      ],
      "max_file_size_mb": 5,
      "token_ttl_minutes": 60,
      "max_concurrent_tokens": 1,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 90
    },
    "knowledge-graph-agent": {
      "directories": [
        ".agents/knowledge-graph-agent/memory/"
      ],
      "allowed_actions": [
        "read",
        "write",
        "create"
      ],
      "allowed_file_patterns": [
        ".agents/knowledge-graph-agent/memory/graph/*.md",
        ".agents/knowledge-graph-agent/memory/edges.md",
        ".agents/knowledge-graph-agent/memory/queries.md",
        ".agents/knowledge-graph-agent/memory/orphans.md"
      ],
      "denied_file_patterns": [
        "backend/app/**",
        "frontend/src/**",
        "scripts/**",
        "docker-compose.yml",
        "Dockerfile.*",
        ".env*",
        "certs/**"
      ],
      "require_approval_for": [
        "Delete a graph node",
        "Change the type of a critical node",
        "Modify auth-service, jwt-utils or session-redis edges"
      ],
      "max_file_size_mb": 2,
      "token_ttl_minutes": 30,
      "max_concurrent_tokens": 1,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 45
    },
    "backend-agent": {
      "directories": [
        "backend/app/"
      ],
      "allowed_actions": [
        "read",
        "write",
        "create",
        "delete"
      ],
      "allowed_file_patterns": [
        "backend/app/**/*.py"
      ],
      "denied_file_patterns": [
        "backend/app/auth.py",
        "backend/app/database.py",
        "backend/requirements*.txt",
        "backend/Dockerfile",
        "pyproject.toml",
        "backend/pytest.ini",
        "docker-compose*.yml",
        "Dockerfile.*",
        ".env*",
        "certs/**"
      ],
      "require_approval_for": [
        "backend/app/main.py",
        "backend/app/dependencies.py",
        "Modify rate limiting or brute-force protection",
        "Modify audit logging behavior"
      ],
      "max_file_size_mb": 5,
      "token_ttl_minutes": 15,
      "max_concurrent_tokens": 1,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 25
    },
    "frontend-agent": {
      "directories": [
        "frontend/src/"
      ],
      "allowed_actions": [
        "read",
        "write",
        "create",
        "delete"
      ],
      "allowed_file_patterns": [
        "frontend/src/**/*.tsx",
        "frontend/src/**/*.ts",
        "frontend/src/**/*.css",
        "frontend/src/**/*.html"
      ],
      "denied_file_patterns": [
        "frontend/tsconfig.json",
        "frontend/tsconfig.node.json",
        "frontend/index.html",
        "frontend/package.json",
        "frontend/pnpm-lock.yaml",
        ".env*"
      ],
      "require_approval_for": [
        "frontend/src/services/api.ts",
        "frontend/vite.config.ts",
        "frontend/tailwind.config.js",
        "frontend/postcss.config.js"
      ],
      "max_file_size_mb": 3,
      "token_ttl_minutes": 15,
      "max_concurrent_tokens": 1,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 25
    },
    "assembly-planner-agent": {
      "directories": [
        "frontend/public/assembly-planner/"
      ],
      "allowed_actions": [
        "read",
        "write",
        "create",
        "delete"
      ],
      "allowed_file_patterns": [
        "frontend/public/assembly-planner/**/*.js",
        "frontend/public/assembly-planner/**/*.mjs",
        "frontend/public/assembly-planner/**/*.html",
        "frontend/public/assembly-planner/**/*.css",
        "frontend/public/assembly-planner/data/**/*"
      ],
      "denied_file_patterns": [
        "frontend/src/**",
        "frontend/package.json",
        "frontend/pnpm-lock.yaml",
        ".env*"
      ],
      "require_approval_for": [
        "frontend/public/assembly-planner/index.html",
        "Change Assembly Planner public URL or build integration"
      ],
      "max_file_size_mb": 3,
      "token_ttl_minutes": 15,
      "max_concurrent_tokens": 1,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 25
    },
    "db-agent": {
      "directories": [
        "scripts/",
        "./"
      ],
      "allowed_actions": [
        "read",
        "write",
        "create"
      ],
      "allowed_file_patterns": [
        "scripts/*.sql",
        "scripts/*.py",
        "backend/app/models.py",
        "init.sql"
      ],
      "denied_actions": [
        "execute_raw_sql"
      ],
      "denied_file_patterns": [
        "backend/app/auth.py",
        ".env*",
        "docker-compose*.yml"
      ],
      "require_approval_for": [
        "init.sql",
        "ALTER TABLE",
        "CREATE INDEX",
        "DROP",
        "DELETE",
        "TRUNCATE"
      ],
      "max_file_size_mb": 2,
      "token_ttl_minutes": 10,
      "max_concurrent_tokens": 1,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 20
    },
    "auth-agent": {
      "directories": [
        "backend/app/"
      ],
      "allowed_actions": [
        "read",
        "write",
        "create"
      ],
      "allowed_file_patterns": [
        "backend/app/auth.py",
        "backend/app/models.py",
        "backend/app/database.py"
      ],
      "denied_file_patterns": [
        ".env*",
        "certs/**"
      ],
      "require_approval_for": [
        "Change token expiration",
        "Switch identity strategy",
        "Modify hardcoded roles",
        "Change hash algorithms",
        "Modify secret keys",
        "Change TOTP issuer or encryption key handling",
        "Add or remove MFA methods (TOTP, guest PIN)"
      ],
      "max_file_size_mb": 3,
      "token_ttl_minutes": 5,
      "max_concurrent_tokens": 1,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 15
    },
    "deploy-agent": {
      "directories": [
        "./"
      ],
      "allowed_actions": [
        "read",
        "write"
      ],
      "allowed_file_patterns": [
        "docker-compose.yml",
        "docker-compose.fase2.yml",
        "docker-compose.fase4.yml",
        "backend/Dockerfile",
        "frontend/Dockerfile",
        "frontend/nginx.conf",
        "whatsapp-gateway/Dockerfile",
        "scripts/*.sh"
      ],
      "denied_file_patterns": [
        "backend/app/**",
        "frontend/src/**",
        ".env*",
        "certs/**",
        "data/**"
      ],
      "require_approval_for": [
        "Change exposed ports",
        "Modify certificate volumes",
        "Deploy to production",
        "Change Docker network",
        "Modify healthchecks",
        "Change base image"
      ],
      "max_file_size_mb": 10,
      "token_ttl_minutes": 30,
      "max_concurrent_tokens": 1,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 45
    },
    "test-agent": {
      "directories": [
        "backend/tests/",
        "frontend/"
      ],
      "allowed_actions": [
        "read",
        "write",
        "create",
        "execute"
      ],
      "allowed_file_patterns": [
        "backend/tests/**/*.py",
        "frontend/**/*.test.ts",
        "frontend/**/*.test.tsx",
        "frontend/public/assembly-planner/**/*.test.js",
        "frontend/public/assembly-planner/**/*.test.mjs",
        "frontend/vitest.config.ts",
        "backend/pytest.ini",
        "pyproject.toml"
      ],
      "read_only_file_patterns": [
        "backend/app/**",
        "frontend/src/**"
      ],
      "denied_file_patterns": [
        ".env*"
      ],
      "require_approval_for": [
        "pyproject.toml",
        "backend/pytest.ini",
        "frontend/vitest.config.ts"
      ],
      "max_file_size_mb": 2,
      "token_ttl_minutes": 15,
      "max_concurrent_tokens": 2,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 25
    },
    "docs-agent": {
      "directories": [
        "./"
      ],
      "allowed_actions": [
        "read",
        "write",
        "create"
      ],
      "allowed_file_patterns": [
        "*.md",
        "docs/**"
      ],
      "denied_file_patterns": [
        "src/**",
        "frontend/src/**",
        "scripts/**",
        ".env*",
        "certs/**"
      ],
      "require_approval_for": [
        "docs/SECURITY.md"
      ],
      "max_file_size_mb": 5,
      "token_ttl_minutes": 15,
      "max_concurrent_tokens": 2,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 25
    },
    "integration-validator": {
      "directories": [
        "./"
      ],
      "allowed_actions": [
        "read",
        "execute"
      ],
      "allowed_file_patterns": [
        "backend/app/**",
        "frontend/src/**",
        "backend/tests/**",
        "frontend/**",
        "package.json",
        "frontend/package.json",
        "pnpm-lock.yaml",
        "frontend/pnpm-lock.yaml",
        "docker-compose*.yml",
        "scripts/**",
        "whatsapp-gateway/**",
        ".agents/**"
      ],
      "denied_file_patterns": [
        ".env*",
        "certs/server.key",
        "certs/ca.key"
      ],
      "read_only_file_patterns": [
        "backend/app/**",
        "frontend/src/**",
        "backend/tests/**",
        "frontend/**",
        "package.json",
        "frontend/package.json",
        "pnpm-lock.yaml",
        "frontend/pnpm-lock.yaml",
        "docker-compose*.yml",
        "scripts/**",
        "whatsapp-gateway/**",
        ".agents/**"
      ],
      "require_approval_for": [
        "Modify test configuration",
        "Approve deployment",
        "Waive any validation step"
      ],
      "max_file_size_mb": 5,
      "token_ttl_minutes": 20,
      "max_concurrent_tokens": 1,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 30
    }
  },
  "global_rules": {
    "no_agent_can": {
      "paths": [
        ".env*",
        "certs/server.key",
        "certs/ca.key"
      ],
      "commands": [
        "rm -rf /",
        "DROP DATABASE",
        "docker system prune",
        "chmod -R 777 /"
      ],
      "actions": [
        "modify .env files",
        "read private keys",
        "modify guardian SKILL.md",
        "modify policies.json"
      ]
    },
    "token_format": "GUARD-[AGENT]-[ACTION]-[RESOURCE]-[TIMESTAMP]-[HASH]",
    "audit_log": ".agents/guardian/audit.log",
    "escalation_required": [
      "any agent reading server.key",
      "any agent modifying .env",
      "any agent holding more than max_concurrent_tokens active tokens",
      "any agent accepting a new task without revoking the previous token",
      "auth-agent modifying backend/app/auth.py",
      "backend-agent modifying backend/app/auth.py",
      "deploy-agent changing backend/Dockerfile base image",
      "db-agent executing DROP or DELETE without WHERE",
      "backend-agent leaving orphaned service, route, util or test file after a refactor",
      "db-agent adding or modifying a table not consumed by any backend service or route",
      "db-agent keeping legacy scripts with conflicting table definitions",
      "any agent creating duplicate or conflicting schema definitions for the same entity",
      "any agent exposing TOTP encryption key or guest PIN secrets"
    ]
  },
  "runtime_limits": {
    "max_iterations_per_plan": 5,
    "max_agent_depth": 3,
    "max_handoffs_per_task": 5,
    "max_tool_calls_per_turn": 50,
    "max_retries_per_tool": 3,
    "max_execution_time_minutes": 30
  },
  "guardrails": {
    "max_steps_default": 15,
    "max_handoffs_per_task": 5,
    "forbidden_cycles": [
      [
        "backend-agent",
        "db-agent"
      ]
    ],
    "stall_detection": {
      "repetition_threshold": 2,
      "inactivity_timeout_minutes": 10,
      "max_steps_exceeded_action": "mark_stalled_and_checkpoint"
    }
  },
  "token_concurrency_rules": {
    "principle": "One active token per agent by default; queued when busy.",
    "max_concurrent_tokens_default": 1,
    "queue_policy_default": "enqueue",
    "orphan_token_timeout_minutes_default": 30,
    "token_states": {
      "active": "Token emitted and not yet completed or revoked.",
      "queued": "Task waiting because agent is at max_concurrent_tokens.",
      "orphan": "Token active beyond orphan_token_timeout_minutes without completion report.",
      "revoked": "Token manually or automatically invalidated."
    },
    "guardian_actions": {
      "emit": "Issue token if agent is below max_concurrent_tokens.",
      "enqueue": "Add request to agent queue if at limit and queue_policy is enqueue.",
      "reject": "Reject request if at limit and queue_policy is reject.",
      "revoke_orphan": "Automatically revoke orphan tokens and notify the agent.",
      "promote_next": "After token revocation, emit token to the next queued task."
    },
    "audit_format": "[ISO_TIMESTAMP] [AGENT] [ACTION] [RESOURCE] [RESULT] [TOKEN] [QUEUE_LEN]"
  },
  "inter_agent_availability_check": {
    "required": true,
    "protocol": "Before sending an inter-agent request, query the Guardian for the target agent's availability.",
    "response_available": "Target is below max_concurrent_tokens; proceed with request.",
    "response_busy": "Target is at limit; enqueue request or escalate to Guardian.",
    "format": "[AGENT: source] → [guardian] Availability check for [target-agent]"
  },
  "memory_layers": {
    "L0": ".devhive/project-brief.md",
    "L1": ".devhive/conventions.md",
    "L2": ".devhive/current-sprint.md",
    "L3": ".agents/{agent}/SKILL.md",
    "L4": ".agents/{agent}/memory/active-tasks.md (agent status only)"
  },
  "knowledge_graph": {
    "enabled": true,
    "agent": "knowledge-graph-agent",
    "location": ".agents/knowledge-graph-agent/memory/",
    "nodes_dir": "graph/",
    "edges_file": "edges.md",
    "queries_file": "queries.md",
    "benefit": "Reduces token consumption by 70-80% for architecture queries"
  },
  "comment": "Merged authoritative policy for cutternest-kit. Derived from policies.base.json, policies.stack.json, and policies.project.json.",
  "project": "cutternest-kit",
  "_source_layers": [
    ".agents/guardian/policies.base.json",
    ".agents/guardian/policies.stack.json",
    ".agents/guardian/policies.project.json"
  ],
  "_regenerate": "node .agents/guardian/scripts/merge-policies.js"
}
