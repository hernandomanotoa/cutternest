      "max_file_size_mb": 5,
      "token_ttl_minutes": 15,
      "max_concurrent_tokens": 1,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 25
    },
    "frontend-agent": {
      "directories": [
        "frontend/src/"
