      "max_file_size_mb": 10,
      "token_ttl_minutes": 30,
      "max_concurrent_tokens": 1,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 45
    },
    "tunnel-agent": {
      "directories": [
        "scripts/tunnel/",
        "./"
      ],
      "allowed_actions": [
        "read",
        "write"
      ],
      "allowed_file_patterns": [
        "docker-compose.tunnels.yml",
        "scripts/tunnel/*.sh",
        "scripts/tunnel/*.mjs",
        "scripts/tunnel/*.md",
        "scripts/tunnel/README.md"
      ],
      "denied_file_patterns": [
