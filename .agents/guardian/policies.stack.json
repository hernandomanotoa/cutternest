{
  "$schema": "https://devhive.local/policies.schema.json",
  "version": "2.2.0-devhive-stack",
  "system": "DevHive",
  "updated": "2026-08-12T15:30:00Z",
  "comment": "Stack-specific policy layer for Python 3.11 + FastAPI + React 18 + Vite + TypeScript + Three.js + Tailwind CSS + SQLite projects. This layer overrides or extends policies.base.json for the target technology stack.",
  "agents": {
    "architect": {
      "directories": [
        ".devhive/",
        ".agents/*/SKILL.md"
      ],
      "allowed_actions": [
        "read",
        "write",
        "create",
        "review"
      ],
      "allowed_file_patterns": [
        ".devhive/*.md",
        ".devhive/decisions/*.md",
        ".devhive/sessions/*.md",
        ".agents/*/SKILL.md"
      ],
      "denied_file_patterns": [
        "backend/app/**",
        "frontend/src/**",
        "scripts/**",
        "docker-compose.yml",
        "Dockerfile.*",
        ".env*",
        "certs/**"
      ],
      "require_approval_for": [
        "Change technology stack",
        "Modify base conventions",
        "Modify project-brief.md stack section",
        "Remove agents from the team"
      ],
      "max_file_size_mb": 5,
      "token_ttl_minutes": 60,
      "max_concurrent_tokens": 1,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 90
    },
    "knowledge-graph-agent": {
      "directories": [
        ".agents/knowledge-graph-agent/memory/"
      ],
      "allowed_actions": [
        "read",
        "write",
        "create"
      ],
      "allowed_file_patterns": [
        ".agents/knowledge-graph-agent/memory/graph/*.md",
        ".agents/knowledge-graph-agent/memory/edges.md",
        ".agents/knowledge-graph-agent/memory/queries.md",
        ".agents/knowledge-graph-agent/memory/orphans.md"
      ],
      "denied_file_patterns": [
        "backend/app/**",
        "frontend/src/**",
        "scripts/**",
        "docker-compose.yml",
        "Dockerfile.*",
        ".env*",
        "certs/**"
      ],
      "require_approval_for": [
        "Delete a graph node",
        "Change the type of a critical node",
        "Modify auth-service, jwt-utils or session-redis edges"
      ],
      "max_file_size_mb": 2,
      "token_ttl_minutes": 30,
      "max_concurrent_tokens": 1,
      "queue_policy": "enqueue",
      "orphan_token_timeout_minutes": 45
    },
    "backend-agent": {
      "directories": [
        "backend/app/"
      ],
      "allowed_actions": [
        "read",
        "write",
        "create",
        "delete"
