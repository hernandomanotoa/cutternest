# ============================================
# CutterNest - Variables de Entorno
# ============================================
# Copiar este archivo a .env y editar los valores

# ============================================
# Base de datos SQLite (MVP)
# ============================================
DATABASE_URL=sqlite:///data/cutternest.db

# ============================================
# JWT (OBLIGATORIO - minimo 32 caracteres)
# ============================================
JWT_SECRET_KEY=super-secret-key-cambiar-en-produccion-minimo-32-caracteres

# ============================================
# TOTP (OBLIGATORIO - minimo 32 caracteres, separado de JWT_SECRET_KEY)
# ============================================
TOTP_ENCRYPTION_KEY=totp-encryption-key-cambiar-en-produccion-minimo-32-car

# ============================================
# CORS (origenes permitidos, separados por coma)
# ============================================
CORS_ORIGINS=http://localhost:3000

# ============================================
# Cookies (produccion: COOKIE_SECURE=true, SameSite=Strict)
# ============================================
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# ============================================
# Fase 2: PostgreSQL + Redis (opcional para MVP)
# ============================================
POSTGRES_PASSWORD=secure_postgres_password_cambiar_esto
REDIS_PASSWORD=secure_redis_password_cambiar_esto

# ============================================
# Fase 4: WhatsApp + SMS (opcional)
# ============================================
WHATSAPP_API_KEY=whatsapp_api_key_cambiar_esto
SMS_ENABLED=false
SMS_GATEWAY_URL=http://sms-gateway:8080/send
SMS_GATEWAY_TOKEN=token_sms_gateway_cambiar_esto

# ============================================
# Proxy Tor (solo usado en build del backend para pip)
# El frontend no necesita proxy en runtime.
# ============================================
TOR_IP=172.31.0.1
TOR_PORT=9150
HTTP_PROXY=socks5h://172.31.0.1:9150
HTTPS_PROXY=socks5h://172.31.0.1:9150
ALL_PROXY=socks5h://172.31.0.1:9150
NO_PROXY=localhost,127.0.0.1

# ============================================
# Certificados corporativos
# Coloca tus archivos .crt en ./certs/ si usas TLS/SSL interceptado.
# Se usan: ca-bundle.crt, pcentral-SRVVADPC-CA-1.crt, python-certifi.crt
# ============================================

# ============================================
# Red Docker: el MVP usa red bridge interna (cutternest-network)
# gestionada por docker-compose.yml; no requiere red externa.
# ============================================
# ============================================
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
GUEST_SESSION_HOURS=4
OFFCUT_THRESHOLD_CM=30
KERF_MM=3
MARGEN_MM=5
