# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# Node
node_modules/
dist/
*.log

# Data & backups
*.db
*.sqlite
*.sqlite3
backups/*.sql
backups/*.png
!backups/.gitkeep
data/exports/*
!data/exports/.gitkeep

# Agentes: se versiona el equipo (SKILL.md, skills, plantillas, políticas,
# memorias del proyecto) para trabajar desde cualquier máquina. Se excluye
# la memoria regenerable por agente (aprendizajes en caliente) y logs (*.log
# ya quedan ignorados arriba).
.agents/**/memory/

# Environment
.env
.env.*
!.env.example

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Docker
*.pid

# Certs/keys (solo montar en runtime; no versionar)
*.pem
*.key
*.crt
!certs/.gitkeep
!certs/README.md

# Vite / caches
.vite/
*.cache
data/frontend-vite-cache/

# Coverage / tests
.coverage

# Temporary agent artifacts
.artifacts/

coverage/
.pytest_cache/
htmlcov/

# Misc virtual envs
.venv-*/

# Windows alternate data streams
*Zone.Identifier*
*Zone.Identifier
frontend/public/assembly-planner/pnpm-lock.yaml

# Playwright E2E
frontend/test-results/
frontend/playwright-report/
frontend/e2e/screenshots/

# pnpm store local (no versionar)
frontend/.pnpm-store/
